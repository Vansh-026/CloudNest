PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_here
REFRESH_TOKEN_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# AWS S3 Storage (Optional: required for S3 storage provider)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# Google OAuth (Optional: for Google sign-in)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Redis & Background Workers (Phase 6)
# Upstash Cloud Redis format: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=
WORKER_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3

# Media & Text Processing
ENABLE_THUMBNAILS=true
ENABLE_OCR=true
ENABLE_EMBEDDINGS=false

# Vector Semantic Search (Pluggable Provider)
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

